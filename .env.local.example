# Bob V1 Local Companion
# Copy this file to .env.local. .env.local is gitignored.
# Keep all credential-bearing services loopback-only.
BOB_HOST=127.0.0.1
BOB_PORT=5002
BOB_WORKSPACE_DIR=./workspaces

CHATGPT_BRIDGE_HOST=127.0.0.1
CHATGPT_BRIDGE_PORT=5001
CHATGPT_BRIDGE_URL=http://127.0.0.1:5001
BOB_COMPANION_UI_URL=http://127.0.0.1:5002/

# Bob opens this ChatGPT target in the background managed browser tab.
# You can later replace this with the exact Bob-enabled ChatGPT Project URL.
CHATGPT_TARGET_URL=https://chatgpt.com/
CHATGPT_CAPTURE_MODE=copy
# CHATGPT_PROFILE_PATH=./chatgpt_profile

# Optional provider credentials. Keep real values only in .env.local.
GITHUB_TOKEN=
SUPABASE_ACCESS_TOKEN=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
