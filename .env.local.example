# Bob V1 Local Companion
# Copy this file to .env.local. .env.local is gitignored.
# Keep all credential-bearing services loopback-only.
BOB_HOST=127.0.0.1
BOB_PORT=5002
BOB_WORKSPACE_DIR=./workspaces
# Repository safety cap. This is per repository, not a global machine cap.
BOB_MAX_PARALLEL_RUNS_PER_REPOSITORY=3
# Bob's currently bound canonical implementation ref.
BOB_CANONICAL_REF=feat/bob-core-v1
# Optional machine-local JSON bindings for additional workspace repositories (SL/AB/etc.).
BOB_REPOSITORY_BINDINGS_JSON=
# Durable ownership/lifecycle state for Bob-started local child processes.
BOB_PROCESS_SUPERVISOR_PATH=./.bob/runtime/process_supervisor.json

CHATGPT_BRIDGE_HOST=127.0.0.1
CHATGPT_BRIDGE_PORT=5001
CHATGPT_BRIDGE_URL=http://127.0.0.1:5001
BOB_COMPANION_UI_URL=http://127.0.0.1:5002/

# Bob cognition is isolated to one dedicated ChatGPT Project in the same account.
# Create/open the private project "Bob", set it to Project-only memory, then paste its exact URL here.
BOB_CHATGPT_PROJECT_NAME=Bob
BOB_CHATGPT_PROJECT_URL=
# Legacy compatibility only; normal V1 runtime should use BOB_CHATGPT_PROJECT_URL.
CHATGPT_TARGET_URL=
# Canonical V1 capture: visible ChatGPT Copy action -> clipboard.
# legacy_dom is compatibility-only and should not be used unless deliberately troubleshooting.
CHATGPT_CAPTURE_MODE=copy
# Large architecture/code responses may legitimately need several minutes.
CHATGPT_RESPONSE_TIMEOUT_SECONDS=360
# Must cover response time plus the traffic-control cooldown budget.
CHATGPT_BRIDGE_TIMEOUT_SECONDS=600
# Shared ChatGPT traffic-control defaults. Repository workers remain independently parallel.
CHATGPT_FRESH_CHAT_MIN_INTERVAL_SECONDS=10
CHATGPT_TRAFFIC_JITTER_SECONDS=3
CHATGPT_RATE_LIMIT_BACKOFF_SECONDS=15,30,60,120
# CHATGPT_PROFILE_PATH=./chatgpt_profile

# Optional provider credentials. Keep real values only in .env.local.
GITHUB_TOKEN=
SUPABASE_ACCESS_TOKEN=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
