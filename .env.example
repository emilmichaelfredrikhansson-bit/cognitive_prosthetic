# Bob API
# Loopback is the safe default. Put authenticated reverse-proxy/tunnel access in front
# of Bob rather than binding directly to a public/LAN interface.
BOB_HOST=127.0.0.1
BOB_PORT=5002
BOB_WORKSPACE_DIR=./workspaces

# ChatGPT browser bridge
# Keep the browser control surface on loopback unless an authenticated transport
# boundary has been deliberately installed.
CHATGPT_BRIDGE_HOST=127.0.0.1
CHATGPT_BRIDGE_PORT=5001
CHATGPT_BRIDGE_URL=http://127.0.0.1:5001
# V1 Local Companion opens this loopback Bob UI in the managed browser.
BOB_COMPANION_UI_URL=http://127.0.0.1:5002/
# V1 cognition must be bound to one dedicated private ChatGPT Project.
BOB_CHATGPT_PROJECT_NAME=Bob
BOB_CHATGPT_PROJECT_URL=
# Legacy compatibility only; normal V1 runtime should use BOB_CHATGPT_PROJECT_URL.
CHATGPT_TARGET_URL=
# Preferred: visible Copy button -> clipboard. "legacy_dom" is compatibility only.
CHATGPT_CAPTURE_MODE=copy
# CHATGPT_PROFILE_PATH=./chatgpt_profile

# Infrastructure adapters
# Use least-privilege credentials. Never commit real secrets.
GITHUB_TOKEN=
SUPABASE_ACCESS_TOKEN=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
# May be runtime-bound instead of committed in workspace config.
CLOUDFLARE_ACCOUNT_ID=
