# Bob API
BOB_PORT=5002
BOB_WORKSPACE_DIR=./workspaces

# ChatGPT browser bridge
CHATGPT_BRIDGE_URL=http://127.0.0.1:5001
# Set this to the Bob-enabled ChatGPT Project URL on the browser runtime.
CHATGPT_TARGET_URL=https://chatgpt.com/
# Preferred: visible Copy button -> clipboard. "legacy_dom" is compatibility only.
CHATGPT_CAPTURE_MODE=copy
# CHATGPT_PROFILE_PATH=./chatgpt_profile

# Infrastructure adapters
# Use least-privilege credentials. Never commit real secrets.
GITHUB_TOKEN=
SUPABASE_ACCESS_TOKEN=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
# May be runtime-bound instead of committed in workspace config.
CLOUDFLARE_ACCOUNT_ID=
