[Unit]
Description=Bob ChatGPT browser bridge
After=network-online.target graphical.target
Wants=network-online.target

[Service]
Type=simple
User=bob
Group=bob
WorkingDirectory=/opt/bob/current
EnvironmentFile=/etc/bob/bob.env
Environment=CHATGPT_BRIDGE_HOST=127.0.0.1
Environment=CHATGPT_PROFILE_PATH=/var/lib/bob/chatgpt-profile
ExecStart=/opt/bob/venv/bin/python /opt/bob/current/chatgpt_api_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/bob
UMask=0077

[Install]
WantedBy=multi-user.target
