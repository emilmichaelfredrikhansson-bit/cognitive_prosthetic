[Unit]\nDescription=Bob ChatGPT browser bridge\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=simple\nUser=bob\nGroup=bob\nWorkingDirectory=/opt/bob/current\nEnvironmentFile=/etc/bob/bob.env\nEnvironment=CHATGPT_BRIDGE_HOST=127.0.0.1\nEnvironment=CHATGPT_PROFILE_PATH=/var/lib/bob/chatgpt-profile\nExecStart=/usr/bin/xvfb-run -a /opt/bob/venv/bin/python /opt/bob/current/chatgpt_api_server.py\nRestart=on-failure\nRestartSec=5\nNoNewPrivileges=true\nPrivateTmp=true\nProtectSystem=full\nProtectHome=true\nReadWritePaths=/var/lib/bob\nUMask=0077\n\n[Install]\nWantedBy=multi-user.target\n